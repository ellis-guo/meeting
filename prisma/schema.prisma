generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Project {
  id              String    @id @default(uuid())
  user_id         String
  name            String
  created_at      DateTime  @default(now())
  reference_files String    @default("")
  document        String    @default("")
  meetings        Meeting[]

  @@index([user_id])
}

model Meeting {
  id                String   @id @default(uuid())
  user_id           String
  project_id        String?
  created_at        DateTime @default(now())
  transcript        String
  summary           String
  processing_status String   @default("pending") // pending / processing / done / failed
  document_diff     String?                        // 加密 JSON; 由后台异步任务写入
  diff_status       String?                        // null / pending / confirmed / dismissed
  project           Project? @relation(fields: [project_id], references: [id])
  chunks            Chunk[]

  @@index([user_id])
  @@index([project_id, diff_status])
}

model ChunkParent {
  id           String  @id @default(uuid())
  meeting_id   String
  project_id   String?
  meeting_date String?
  content      String
  speakers     String
  line_start   Int?
  line_end     Int?

  @@index([meeting_id])
  @@index([project_id])
}

model Chunk {
  id            String                       @id @default(uuid())
  meeting_id    String
  project_id    String?
  chunk_type    String
  content       String
  section_title String?
  speaker       String?
  line_start    Int?
  line_end      Int?
  meeting_date  String?
  search_text   String?
  embedding     Unsupported("vector(1024)")?
  parent_id     String?
  meeting       Meeting                      @relation(fields: [meeting_id], references: [id])
}

model ProcessingLog {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  level      String
  meeting_id String?
  context    String
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String   // diff_pending | (后续可扩展)
  title      String
  body       String
  link       String   // 例: /projects/{pid}/meetings/{mid}
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id, created_at])
}
